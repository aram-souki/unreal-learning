# Visual Studio / editor files
**/.vs/
*.sln
*.slnx
*.suo
*.opensdf
*.ncb
*.sdf
*.VC.db
*.VC.VC.opendb

# Compiled binaries
**/Binaries/

# Builds
**/Build/*
!**/Build/**/Resources/**/*.ico

# Derived data cache
**/DerivedDataCache/

# Compiled intermediate files
**/Intermediate/

# Cached per-user config (keep shared config)
**/Saved/*
!**/Saved/Config/
!**/Saved/Config/**/*.ini

# Source control housekeeping from other VCS
.hg/
.svn/

# OS files
.DS_Store
Thumbs.db
